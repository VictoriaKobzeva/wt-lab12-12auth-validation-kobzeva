@page
@model LoginModel

@{
    ViewData["Title"] = "Вход";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm rounded-4 border-0">
                <div class="card-body p-4">
                    <h1 class="fw-bold mb-4">🔑 Вход</h1>

                    @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
                    {
                        <div class="alert alert-warning">
                            Для доступа к личному кабинету необходимо войти в систему.
                        </div>
                    }

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="Login" class="form-label">Логин</label>
                            <input asp-for="Login" class="form-control form-control-lg"
                                   autocomplete="username" placeholder="Введите логин" />
                            <span asp-validation-for="Login" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Пароль</label>
                            <input asp-for="Password" type="password"
                                   class="form-control form-control-lg"
                                   autocomplete="current-password" placeholder="Введите пароль" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            Войти
                        </button>
                    </form>

                    <div class="alert alert-info mt-4 mb-0 small">
                        Тестовая учётная запись:
                        <strong>student</strong> / <strong>1234</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
