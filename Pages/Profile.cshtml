@page
@model ProfileModel

@{
    ViewData["Title"] = "Личный кабинет";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="fw-bold mb-1">👤 Личный кабинет</h1>
            <p class="text-muted mb-0">
                Пользователь: <strong>@Model.UserLogin</strong>
            </p>
        </div>
        <form method="post">
            <button type="submit" class="btn btn-danger btn-lg">
                Выйти
            </button>
        </form>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card shadow-sm rounded-4 border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Всего в избранном</div>
                    <div class="display-6 fw-bold text-primary">@Model.Favorites.Count</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card shadow-sm rounded-4 border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Доступно сейчас</div>
                    <div class="display-6 fw-bold text-success">
                        @Model.Favorites.Count(f => f.Property?.IsAvailable == true)
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card shadow-sm rounded-4 border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Общая стоимость</div>
                    <div class="fs-4 fw-bold text-primary mt-2">
                        @Model.Favorites.Sum(f => f.Property?.Price ?? 0m).ToString("N0") BYN
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h2 class="h4 fw-bold mb-0">❤️ Избранные объекты</h2>
        <a asp-page="/Products/Index" class="btn btn-outline-primary">
            Перейти в каталог
        </a>
    </div>

    @if (Model.Favorites.Count == 0)
    {
        <div class="alert alert-info">
            Вы ещё не добавили ни одного объекта в избранное.
            Откройте <a asp-page="/Products/Index" class="alert-link">каталог</a>
            и нажмите 🤍 на карточке объекта.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var favorite in Model.Favorites)
            {
                var property = favorite.Property;
                if (property == null)
                {
                    continue;
                }

                <div class="col-12 col-md-6">
                    <div class="card h-100 shadow-sm rounded-4 border-0">
                        <div class="card-body d-flex flex-column">
                            <div class="mb-2">
                                <span class="badge bg-secondary">ID: @property.Id</span>
                                <span class="badge bg-info text-dark">@property.Type</span>
                                @if (property.IsAvailable)
                                {
                                    <span class="badge bg-success">Доступен</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Недоступен</span>
                                }
                            </div>

                            <h5 class="card-title fw-bold">@property.Address</h5>
                            <p class="text-muted mb-2">
                                📐 @property.Area м² · 🚪 @property.Rooms комн.
                            </p>

                            @if (!string.IsNullOrWhiteSpace(property.Description))
                            {
                                <p class="text-secondary small mb-2">@property.Description</p>
                            }

                            <p class="fs-5 fw-bold text-primary mt-auto">
                                @property.Price.ToString("N0") BYN
                            </p>

                            <div class="d-flex gap-2 mt-auto">
                                <a asp-page="/Products/Details" asp-route-id="@property.Id"
                                   class="btn btn-outline-primary flex-fill">
                                    Подробнее
                                </a>
                                <form method="post" asp-page-handler="RemoveFavorite"
                                      asp-route-id="@favorite.Id">
                                    <button type="submit" class="btn btn-outline-danger"
                                            title="Убрать из избранного">
                                        🗑️ Убрать
                                    </button>
                                </form>
                            </div>

                            <div class="text-muted small mt-2">
                                Добавлено: @favorite.AddedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
